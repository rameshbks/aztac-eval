{
  "realm": "aztac",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "agent-platform",
      "name": "Enterprise agent platform",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "aztac-agent-platform-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/*"
      ],
      "protocolMappers": [
        {
          "name": "audience-agent-platform",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-platform",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@aztac.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}